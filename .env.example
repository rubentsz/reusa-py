# PostgreSQL connection string (Neon, Supabase o Prisma Postgres desde Vercel Storage)
DATABASE_URL="postgresql://user:password@host:5432/reusa_py?sslmode=require"

# Clave secreta aleatoria para firmar sesiones de usuario (generá una cadena larga)
AUTH_SECRET="cambia-esto-por-un-secreto-seguro-en-vercel"

# Opcional (recomendado en Vercel): se inyecta automáticamente al activar Vercel Blob en Storage
BLOB_READ_WRITE_TOKEN=""

# Opcional: URL pública de producción (ej. https://reusa-py.vercel.app)
NEXT_PUBLIC_SITE_URL=""
